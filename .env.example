# Your production HTTPS domain (used for canonical URLs, sitemap, robots.txt, and OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend (https://resend.com) — required for the contact form to actually send email.
# If these are left unset, the contact API returns a friendly "not configured yet" message
# instead of crashing.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@your-domain.com
CONTACT_FROM_EMAIL=contact@your-domain.com
